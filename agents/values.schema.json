{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "argo.helm.charts/agents",
  "title": "agents",
  "type": "object",
  "properties": {
    "agents": {
      "description": "Agent specifications keyed by resource name",
      "type": "object",
      "additionalProperties": true
    },
    "enabled": {
      "description": "Render Agent Registry resources",
      "type": "boolean"
    },
    "global": {
      "type": "object",
      "properties": {
        "appContext": {
          "description": "Argus-managed context ConfigMap names",
          "type": "object",
          "properties": {
            "envContextConfigMapName": {
              "description": "Environment context ConfigMap name",
              "type": "string"
            },
            "stackContextConfigMapName": {
              "description": "Stack context ConfigMap name",
              "type": "string"
            }
          }
        },
        "appSecrets": {
          "description": "Argus-managed Secret names",
          "type": "object",
          "properties": {
            "clusterCLISecret": {
              "type": "object",
              "properties": {
                "secretName": {
                  "description": "Cluster CLI Secret name",
                  "type": "string"
                }
              }
            },
            "clusterSecret": {
              "type": "object",
              "properties": {
                "secretName": {
                  "description": "Cluster Secret name",
                  "type": "string"
                }
              }
            },
            "envSecret": {
              "type": "object",
              "properties": {
                "secretName": {
                  "description": "Environment Secret name",
                  "type": "string"
                }
              }
            },
            "stackSecret": {
              "type": "object",
              "properties": {
                "secretName": {
                  "description": "Stack Secret name",
                  "type": "string"
                }
              }
            }
          }
        },
        "argusMetadata": {
          "description": "Argus metadata",
          "type": "object",
          "properties": {
            "stackName": {
              "description": "Argus stack name",
              "type": "string"
            }
          }
        },
        "env": {
          "description": "Non-sensitive environment variables inherited by every Agent",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "valueFrom": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "profiles": {
      "description": "AgentProfile specifications keyed by resource name",
      "type": "object",
      "additionalProperties": true
    }
  }
}
