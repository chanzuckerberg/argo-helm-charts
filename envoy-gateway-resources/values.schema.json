{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "argo.helm.charts/envoy-gateway-resources",
  "title": "envoy-gateway-resources",
  "type": "object",
  "required": [
    "baseDomain"
  ],
  "properties": {
    "accessLog": {
      "type": "object",
      "properties": {
        "omitSuccessful": {
          "type": "boolean"
        }
      }
    },
    "alternateNames": {
      "type": "array"
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxReplicas": {
          "type": "integer"
        },
        "minReplicas": {
          "type": "integer"
        },
        "targetCPUUtilizationPercentage": {
          "type": "integer"
        }
      }
    },
    "awsRegion": {
      "type": "string"
    },
    "baseDomain": {
      "description": "Base domain the gateway serves. The ApplicationSet injects this per cluster from the base-domain label, so an unlabelled cluster renders it empty rather than absent, which minLength catches and required would not.",
      "type": "string",
      "minLength": 1
    },
    "envoyService": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string"
        }
      }
    },
    "extraDns01Zones": {
      "description": "Additional DNS zones the letsencrypt-prod-eg dns01 solver may answer for, on top of baseDomain. Use it when a stack serves a vanity host whose zone lives in the cluster account and http01 cannot reach the gateway, for example behind CloudFront",
      "type": "array"
    },
    "gatewayName": {
      "type": "string"
    },
    "geoip": {
      "type": "object",
      "properties": {
        "blockedCountries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "hsts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "listenerSets": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "from": {
          "type": "string"
        },
        "namespaceSelector": {
          "type": "object"
        }
      }
    },
    "proxyProtocol": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "optional": {
          "type": "boolean"
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "limits": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "string"
            }
          }
        },
        "requests": {
          "type": "object",
          "properties": {
            "cpu": {
              "type": "string"
            },
            "memory": {
              "type": "string"
            }
          }
        }
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "tlsPassthrough": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostnames": {
          "type": "array"
        }
      }
    }
  }
}
